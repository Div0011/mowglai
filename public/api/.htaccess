# CORS & API Security Headers for Mowglai API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS, PUT, DELETE"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Origin, Accept"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

# Handle Preflight OPTIONS requests cleanly
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>

# Prevent directory indexing
Options -Indexes

# Fallback for API routing
DirectoryIndex audit.php db.php index.php

