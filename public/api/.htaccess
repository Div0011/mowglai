# ==============================================================================
# Mowglai API Subdirectory Security & CORS (.htaccess)
# ==============================================================================

# Prevent directory listing
Options -Indexes -MultiViews

# Default document entry: Only index.php gateway
DirectoryIndex index.php

# Block access to database config, SQL schemas, and logs
<FilesMatch "^(db\.php|schema\.sql|.*\.log|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# CORS Headers (Restricted origin or validated API usage)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header always set Access-Control-Max-Age "86400"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Handle Preflight OPTIONS requests cleanly
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
